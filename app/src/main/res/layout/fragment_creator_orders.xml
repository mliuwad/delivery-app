<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <androidx.appcompat.widget.SearchView android:id="@+id/searchOrders"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:queryHint="Tìm mã đơn hoặc tên người nhận" />
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabsOrderStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:tabMode="scrollable" app:tabTextColor="@color/gray"
        app:tabSelectedTextColor="@color/primary" />
    <TextView android:id="@+id/txtTotalCreatorOrders"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="10dp" android:text="Tổng số: 0 đơn hàng"
        android:textColor="@color/gray" android:textStyle="bold" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCreatorOrders"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" />
</LinearLayout>