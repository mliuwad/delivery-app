<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <EditText android:id="@+id/etSearchCreatorProducts" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1"
            android:background="@drawable/rounded_edittext" android:hint="Tìm sản phẩm..."
            android:inputType="text" android:paddingHorizontal="12dp" />
        <ImageButton android:id="@+id/btnClearCreatorSearch" android:layout_width="40dp"
            android:layout_height="40dp" android:background="@android:color/transparent"
            android:contentDescription="Xóa tìm kiếm" android:src="@drawable/svg_close"
            android:visibility="gone" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnAddCreatorProduct"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="THÊM SẢN PHẨM" />
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipeCreatorProducts"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCreatorProducts"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="4dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <TextView android:id="@+id/txtCreatorProductCount" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="10dp"
        android:text="Tổng số: 0 sản phẩm" android:textColor="@color/gray"
        android:textStyle="bold" />
</LinearLayout>